{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "bootstrap",
      "displayName": "Repository foundation",
      "description": "Use the locally available generator and compiler; no simulator is built.",
      "binaryDir": "${sourceDir}/build/bootstrap"
    }
  ],
  "buildPresets": [
    {
      "name": "check-repository",
      "configurePreset": "bootstrap",
      "configuration": "Debug",
      "targets": ["check-repository"]
    }
  ]
}
