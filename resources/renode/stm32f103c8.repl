// Copyright (c) 2026 Ricardo Kerschbaumer; SPDX-License-Identifier: MIT
// STM32F103C8 subset for SimNodus (from E-02): exact 64 KiB flash and 20 KiB
// SRAM, GPIO ports A-C (SimNodusGpio.cs) with EXTI, USART1..3 and the clock
// tree (SimNodusRcc.cs): the CPU starts at 8 MIPS with an 8 MHz SysTick
// (HSI, the reset clock); both follow HCLK when the firmware configures
// HSE/PLL (72 MHz in STM32CubeIDE projects). The SimNodus*.cs files are
// included before this file. Works offline. Not a complete MCU description:
// no AFIO, so EXTI line n follows pin n of every port (AFIO_EXTICR port
// selection is not modeled).
flash: Memory.MappedMemory @ {
    sysbus 0x08000000;
    sysbus 0x00000000
}
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x5000

// Cortex-M3 bit-band aliases: one word per bit of SRAM and of the peripherals
// (the F1 HAL switches HSION, PLLON and LSION this way).
bitbandSram: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x200000>
    peripheralBase: 0x20000000

bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

// Ready flags, SWS and HCLK; SysTick and CPU speed follow HCLK (SN-137).
rcc: Miscellaneous.SimNodusSTM32F1RCC @ sysbus 0x40021000
    nvic: nvic
    cpu: cpu
    hseFrequency: 8000000

// Register stores so that HAL reads back what it wrote: FLASH_ACR latency
// (HAL_RCC_ClockConfig fails otherwise) and PWR_CR DBP (LSE/RTC set-up).
// Flash programming and low-power modes are not modeled.
flashInterfaceStorage: Memory.ArrayMemory @ sysbus 0x40022000
    size: 0x400

pwrRegisterStorage: Memory.ArrayMemory @ sysbus 0x40007000
    size: 0x400

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 8000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic
    PerformanceInMips: 8

gpioPortA: GPIOPort.SimNodusSTM32F1GPIOPort @ sysbus <0x40010800, +0x400>
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.SimNodusSTM32F1GPIOPort @ sysbus <0x40010C00, +0x400>
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.SimNodusSTM32F1GPIOPort @ sysbus <0x40011000, +0x400>
    [0-15] -> exti@[0-15]

// USART1..3 (SN-134): bytes move instantly; the baud rate is not simulated.
usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    -> nvic@37

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39

// EXTI0..4 -> IRQ 6..10, EXTI9_5 -> IRQ 23, EXTI15_10 -> IRQ 40 (as on the chip).
exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 19
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40
