    "kind": "sdcard",
    "supply_pin": "VCC",
    "ground_pin": "GND",
    "output_resistance": 50,
    "memory_size_parameter": "size",
    "memory_fill": 0,
    "contents_parameter": "contents"
  },
  "spice": [
    "R_{ref}_hcs {node:CS} {node:GND} 100Meg",
    "R_{ref}_hsck {node:SCK} {node:GND} 100Meg",
    "R_{ref}_hmosi {node:MOSI} {node:GND} 100Meg",
    "R_{ref}_hmiso {node:MISO} {node:GND} 100Meg",
    "B_{ref}_miso {node:GND} {node:MISO} I=V({ext:miso_i})-V({ext:miso_g})*(V({node:MISO})-V({node:GND}))",
    "R_{ref}_q {node:VCC} {node:GND} 100k"
  ],
  "parameters": [
    {
      "name": "size",
      "label": "Size (bytes)",
      "unit": "",
      "default": "8M",
      "choices": [
        "1M",
        "2M",
        "4M",
        "8M",
        "16M",
        "32M",
        "64M"
      ],
      "description": "Capacity of the card"
    },
    {
      "name": "contents",
      "label": "Image file",
      "kind": "file",
      "filter": "*.img *.bin",
      "default": "",
      "description": "Card image the run starts with (raw blocks, stored relative to the project); empty: all zeros"
    }
  ],
  "value_parameter": "size"
}
