  "designator_offset": [
    5,
    -4
  ],
  "value_offset": [
    5,
    4
  ],
  "device": {
    "kind": "serial_port",
    "ground_pin": "GND",
    "output_resistance": 50,
    "driven_pins": [
      "TX"
    ],
    "supply_parameter": "level"
  },
  "spice": [
    "R_{ref}_hrx {node:RX} {node:GND} 100Meg",
    "R_{ref}_htx {node:TX} {node:GND} 100Meg",
    "B_{ref}_tx {node:GND} {node:TX} I=V({ext:tx_i})-V({ext:tx_g})*(V({node:TX})-V({node:GND}))"
  ],
  "parameters": [
    {
      "name": "port",
      "label": "Port",
      "kind": "text",
      "serial_port": true,
      "default": "loopback",
      "description": "The computer's serial port (COM3, /dev/ttyUSB0); loopback sends back what it receives"
    },
    {
      "name": "baud",
      "label": "Baud rate",
      "choices": [
        "300",
        "1200",
        "2400",
        "4800",
        "9600",
        "19200",
        "38400",
        "57600",
        "115200",
        "230400",
        "460800",
        "921600"
      ],
      "default": "115200",
      "description": "Bits per second, the same on the port and on the circuit"
    },
    {
      "name": "data_bits",
      "label": "Data bits",
      "choices": [
        "5",
        "6",
        "7",
        "8"
      ],
      "default": "8",
      "description": "Data bits per frame"
    },
    {
      "name": "parity",
      "label": "Parity",
      "choices": [
        "None",
        "Even",
        "Odd"
      ],
      "default": "None",
      "description": "Parity bit after the data bits"
    },
    {
      "name": "stop_bits",
      "label": "Stop bits",
      "choices": [
        "1",
        "2"
      ],
      "default": "1",
      "description": "Stop bits per frame"
    },
    {
      "name": "level",
      "label": "Level",
      "choices": [
        "3.3 V",
        "5 V"
      ],
      "default": "3.3 V",
      "description": "High level of TX, like the adapter's 3.3 V or 5 V setting"
    }
  ],
  "value_parameter": "port"
}
