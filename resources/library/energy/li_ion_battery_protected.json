        ]
      },
      {
        "text": "Li",
        "at": [
          -2.6,
          -0.4
        ],
        "size": 1.1
      }
    ],
    "pins": [
      {
        "name": "+",
        "at": [
          0,
          -4
        ],
        "dir": "up"
      },
      {
        "name": "-",
        "at": [
          0,
          4
        ],
        "dir": "down"
      }
    ]
  },
  "designator_offset": [
    3,
    -2
  ],
  "value_offset": [
    3,
    2
  ],
  "value_parameter": "capacity",
  "parameters": [
    {
      "name": "capacity",
      "label": "Capacity",
      "unit": "mAh",
      "default": "2500",
      "description": "Capacity of each cell",
      "min": "1",
      "max": "100k"
    },
    {
      "name": "cells",
      "label": "Cells in series",
      "unit": "",
      "default": "1",
      "description": "Cells in series (1S to 4S); voltages and resistances add",
      "min": "1",
      "max": "4"
    },
    {
      "name": "soc0",
      "label": "Initial state of charge",
      "unit": "%",
      "default": "50",
      "description": "State of charge when the run starts",
      "min": "0",
      "max": "100"
    },
    {
      "name": "accel",
      "label": "Time acceleration",
      "unit": "",
      "default": "1",
      "description": "Divides the capacity and the RC time constant, so a charge of hours runs in minutes with the same voltages and currents (1 = real time; 60 = an hour in a minute)",
      "min": "1",
      "max": "3600"
    },
    {
      "name": "R0",
      "label": "Series resistance",
      "unit": "Ohm",
      "default": "50m",
      "description": "Internal resistance of each cell",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "R1",
      "label": "Polarization resistance",
      "unit": "Ohm",
      "default": "30m",
      "description": "Resistance of the RC pair of each cell (the slow part of the voltage drop)",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "tau",
      "label": "Polarization time constant",
      "unit": "s",
      "default": "30",
      "description": "Time constant of the RC pair (before the acceleration)",
      "min": "1",
      "max": "1000"
    }
  ],
  "models": [
    ".model D_LIP D(IS=1e-9 N=1.2 RS=0.01)",
    ".model SW_LIIONC SW(VT=0.05 VH=0.05 RON=0.01 ROFF=1e9)",
    ".model SW_LIIOND SW(VT=0.25 VH=0.25 RON=0.01 ROFF=1e9)"
  ],
  "readout": {
    "kind": "node",
    "element": "r_{ref}",
    "scale": 1,
    "unit": "% SOC"
  },
  "spice": [
    "V_{ref}_i {node:+} a_{ref} DC 0",
    "B_{ref}_q 0 q_{ref} I=I(V_{ref}_i)/({capacity}*3.6/{accel})",
    "C_{ref}_q q_{ref} 0 1",
    "R_{ref}_q q_{ref} 0 1T",
    "B_{ref}_s s_{ref} 0 V={soc0}/100+V(q_{ref})",
    "B_{ref}_e e_{ref} {node:-} V={cells}*(pwl(V(s_{ref}),0,3.0,0.05,3.45,0.1,3.55,0.2,3.62,0.3,3.68,0.4,3.73,0.5,3.78,0.6,3.85,0.7,3.92,0.8,4.0,0.9,4.08,1.0,4.2)+5*max(V(s_{ref})-1,0)-5*max(-V(s_{ref}),0))",
    "R_{ref}_1 c_{ref} e_{ref} {= cells * R1}",
    "C_{ref}_1 c_{ref} e_{ref} {= tau / accel / R1 / cells}",
    "B_{ref}_r r_{ref} 0 V=100*V(s_{ref})",
    "R_{ref}_0 a_{ref} b_{ref} {= cells * R0}",
    "B_{ref}_v v_{ref} 0 V=V(c_{ref},{node:-})/{cells}",
    "B_{ref}_oc oc_{ref} 0 V=4.25-V(v_{ref})",
    "S_{ref}_c b_{ref} m_{ref} oc_{ref} 0 SW_LIIONC",
    "D_{ref}_c m_{ref} b_{ref} D_LIP",
    "B_{ref}_od od_{ref} 0 V=V(v_{ref})-2.5",
    "S_{ref}_d m_{ref} c_{ref} od_{ref} 0 SW_LIIOND",
    "D_{ref}_d m_{ref} c_{ref} D_LIP"
  ]
}
