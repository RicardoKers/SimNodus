{
  "type": "li_ion_battery_protected",
  "name": "Lithium-ion battery with protection",
  "category": "Sources",
  "prefix": "BT",
  "description": "Lithium-ion (NMC/LCO) cells, 3.7 V nominal, 4.2 V full, 3.0 V empty; Thevenin model (open-circuit voltage from the state of charge, series resistance and an RC pair) with a time acceleration for chargers; shows the state of charge. No temperature, aging or self-discharge. Protection like a DW01: charging stops above 4.25 V per cell (again below 4.15 V), discharging below 2.5 V (again above 3.0 V)",
  "symbol": {
    "graphics": [
      {
        "line": [
          -1.6,
          -1.6,
          1.6,
          -1.6
        ]
      },
      {
        "line": [
          -0.8,
          -0.9,
          0.8,
          -0.9
        ]
      },
      {
        "line": [
          -1.6,
          0.2,
          1.6,
          0.2
        ]
      },
      {
        "line": [
          -0.8,
          0.9,
          0.8,
          0.9
        ]
      },
      {
        "line": [
          1.4,
          -2.6,
          1.4,
          -2.0
        ]
      },
      {
        "line": [
          1.1,
          -2.3,
