  "value_parameter": "capacity",
  "parameters": [
    {
      "name": "capacity",
      "label": "Capacity",
      "unit": "mAh",
      "default": "1500",
      "description": "Capacity of each cell",
      "min": "1",
      "max": "100k"
    },
    {
      "name": "cells",
      "label": "Cells in series",
      "unit": "",
      "default": "1",
      "description": "Cells in series (1S to 4S); voltages and resistances add",
      "min": "1",
      "max": "4"
    },
    {
      "name": "soc0",
      "label": "Initial state of charge",
      "unit": "%",
      "default": "50",
      "description": "State of charge when the run starts",
      "min": "0",
      "max": "100"
    },
    {
      "name": "accel",
      "label": "Time acceleration",
      "unit": "",
      "default": "1",
      "description": "Divides the capacity and the RC time constant, so a charge of hours runs in minutes with the same voltages and currents (1 = real time; 60 = an hour in a minute)",
      "min": "1",
      "max": "3600"
    },
    {
      "name": "R0",
      "label": "Series resistance",
      "unit": "Ohm",
      "default": "40m",
      "description": "Internal resistance of each cell",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "R1",
      "label": "Polarization resistance",
      "unit": "Ohm",
      "default": "20m",
      "description": "Resistance of the RC pair of each cell (the slow part of the voltage drop)",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "tau",
      "label": "Polarization time constant",
      "unit": "s",
      "default": "30",
      "description": "Time constant of the RC pair (before the acceleration)",
      "min": "1",
      "max": "1000"
    }
  ],
  "readout": {
    "kind": "node",
    "element": "r_{ref}",
    "scale": 1,
    "unit": "% SOC"
  },
  "live": [
    {
      "label": "I",
      "kind": "current",
      "element": "V_{ref}_i",
      "scale": -1,
      "unit": "A"
    },
    {
      "label": "State of charge",
      "kind": "node",
      "element": "r_{ref}",
      "unit": "%"
    }
  ],
  "spice": [
    "V_{ref}_i {node:+} a_{ref} DC 0",
    "B_{ref}_q 0 q_{ref} I=I(V_{ref}_i)/({capacity}*3.6/{accel})",
    "C_{ref}_q q_{ref} 0 1",
    "R_{ref}_q q_{ref} 0 1T",
    "B_{ref}_s s_{ref} 0 V={soc0}/100+V(q_{ref})",
    "B_{ref}_e e_{ref} {node:-} V={cells}*(pwl(V(s_{ref}),0,2.5,0.05,3.0,0.1,3.15,0.2,3.22,0.3,3.25,0.4,3.27,0.5,3.28,0.6,3.29,0.7,3.3,0.8,3.32,0.9,3.35,0.95,3.4,1.0,3.6)+5*max(V(s_{ref})-1,0)-5*max(-V(s_{ref}),0))",
    "R_{ref}_1 c_{ref} e_{ref} {= cells * R1}",
    "C_{ref}_1 c_{ref} e_{ref} {= tau / accel / R1 / cells}",
    "B_{ref}_r r_{ref} 0 V=100*V(s_{ref})",
    "R_{ref}_0 a_{ref} c_{ref} {= cells * R0}"
  ]
}
