      "min": "0.1",
      "max": "1k"
    },
    {
      "name": "L",
      "label": "Coil inductance",
      "unit": "H",
      "default": "40m",
      "description": "Inductance of each coil",
      "min": "10u",
      "max": "10"
    },
    {
      "name": "Irated",
      "label": "Rated current",
      "unit": "A",
      "default": "400m",
      "description": "Coil current for the full holding torque",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "steps",
      "label": "Steps per revolution",
      "unit": "",
      "default": "200",
