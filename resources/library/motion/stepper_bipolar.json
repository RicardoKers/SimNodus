  ],
  "readout": {
    "kind": "node",
    "element": "ang_{ref}",
    "scale": 1,
    "unit": "°"
  },
  "spice": [
    "V_{ref}_a {node:A+} ca_{ref} DC 0",
    "R_{ref}_ra ca_{ref} la_{ref} {R}",
    "L_{ref}_a la_{ref} {node:A-} {L}",
    "V_{ref}_b {node:B+} cb_{ref} DC 0",
    "R_{ref}_rb cb_{ref} lb_{ref} {R}",
    "L_{ref}_b lb_{ref} {node:B-} {L}",
    "B_{ref}_th 0 th_{ref} I={= 2000 / Irated}*(I(V_{ref}_b)*cos(V(th_{ref}))-I(V_{ref}_a)*sin(V(th_{ref})))",
    "C_{ref}_th th_{ref} 0 1",
    "R_{ref}_th th_{ref} 0 1G",
    "B_{ref}_ang ang_{ref} 0 V=floor(V(th_{ref})*5729.578/{= steps / 4}+0.5)/100"
  ]
