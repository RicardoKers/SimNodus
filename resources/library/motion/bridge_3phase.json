      "max": "10"
    }
  ],
  "spice": [
    "B_{ref}_d1 d1_{ref} 0 V=min(max(V({node:IN1},{node:GND})/{vio},0),1)",
    "B_{ref}_o1 o1_{ref} {node:GND} V=V({node:VM},{node:GND})*V(d1_{ref})",
    "R_{ref}_r1 o1_{ref} s1_{ref} {Ron}",
    "V_{ref}_i1 s1_{ref} p1_{ref} DC 0",
    "B_{ref}_c1 c1_{ref} 0 V=V({node:EN1},{node:GND})/{vio}",
    "B_{ref}_e1 p1_{ref} x1_{ref} I=V(p1_{ref},x1_{ref})*(1e-9+1000*min(max(V(c1_{ref}),0),1))",
    "B_{ref}_h1 x1_{ref} {node:VM} I=10*max(V(x1_{ref},{node:VM})-0.6,0)",
    "B_{ref}_l1 {node:GND} x1_{ref} I=10*max(V({node:GND},x1_{ref})-0.6,0)",
    "R_{ref}_z1 x1_{ref} {node:GND} 10Meg",
    "V_{ref}_m1 x1_{ref} {node:OUT1} DC 0",
    "B_{ref}_d2 d2_{ref} 0 V=min(max(V({node:IN2},{node:GND})/{vio},0),1)",
    "B_{ref}_o2 o2_{ref} {node:GND} V=V({node:VM},{node:GND})*V(d2_{ref})",
    "R_{ref}_r2 o2_{ref} s2_{ref} {Ron}",
    "V_{ref}_i2 s2_{ref} p2_{ref} DC 0",
    "B_{ref}_c2 c2_{ref} 0 V=V({node:EN2},{node:GND})/{vio}",
    "B_{ref}_e2 p2_{ref} x2_{ref} I=V(p2_{ref},x2_{ref})*(1e-9+1000*min(max(V(c2_{ref}),0),1))",
    "B_{ref}_h2 x2_{ref} {node:VM} I=10*max(V(x2_{ref},{node:VM})-0.6,0)",
    "B_{ref}_l2 {node:GND} x2_{ref} I=10*max(V({node:GND},x2_{ref})-0.6,0)",
    "R_{ref}_z2 x2_{ref} {node:GND} 10Meg",
    "V_{ref}_m2 x2_{ref} {node:OUT2} DC 0",
    "B_{ref}_d3 d3_{ref} 0 V=min(max(V({node:IN3},{node:GND})/{vio},0),1)",
    "B_{ref}_o3 o3_{ref} {node:GND} V=V({node:VM},{node:GND})*V(d3_{ref})",
    "R_{ref}_r3 o3_{ref} s3_{ref} {Ron}",
    "V_{ref}_i3 s3_{ref} p3_{ref} DC 0",
    "B_{ref}_c3 c3_{ref} 0 V=V({node:EN3},{node:GND})/{vio}",
    "B_{ref}_e3 p3_{ref} x3_{ref} I=V(p3_{ref},x3_{ref})*(1e-9+1000*min(max(V(c3_{ref}),0),1))",
    "B_{ref}_h3 x3_{ref} {node:VM} I=10*max(V(x3_{ref},{node:VM})-0.6,0)",
    "B_{ref}_l3 {node:GND} x3_{ref} I=10*max(V({node:GND},x3_{ref})-0.6,0)",
    "R_{ref}_z3 x3_{ref} {node:GND} 10Meg",
    "V_{ref}_m3 x3_{ref} {node:OUT3} DC 0",
    "B_{ref}_vm {node:VM} {node:GND} I=V(d1_{ref})*I(V_{ref}_i1)+V(d2_{ref})*I(V_{ref}_i2)+V(d3_{ref})*I(V_{ref}_i3)",
    "R_{ref}_in1 {node:IN1} {node:GND} 1Meg",
    "R_{ref}_in2 {node:IN2} {node:GND} 1Meg",
    "R_{ref}_in3 {node:IN3} {node:GND} 1Meg",
    "R_{ref}_en1 {node:EN1} {node:GND} 1Meg",
    "R_{ref}_en2 {node:EN2} {node:GND} 1Meg",
    "R_{ref}_en3 {node:EN3} {node:GND} 1Meg"
