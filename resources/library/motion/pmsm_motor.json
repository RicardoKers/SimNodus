      "max": "1"
    },
    {
      "name": "pairs",
      "label": "Pole pairs",
      "unit": "",
      "default": "4",
      "description": "Pole pairs: electrical turns per mechanical turn",
      "min": "1",
      "max": "20"
    },
    {
      "name": "Inoload",
      "label": "No-load current",
      "unit": "A",
      "default": "200m",
      "description": "Bus current at the no-load speed (sets the friction)",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "tm",
      "label": "Mechanical time constant",
      "unit": "s",
      "default": "50m",
      "description": "Time to reach 63 % of the speed from rest with the shaft free; sets the inertia",
      "min": "1m",
      "max": "10"
    },
    {
      "name": "load",
      "label": "Load",
      "unit": "%",
      "default": "0",
      "description": "Load torque on the shaft as a share of the stall torque; drag the part or use the wheel while running",
      "min": "0",
      "max": "100"
    }
