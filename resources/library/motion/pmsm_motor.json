  "spice": [
    "V_{ref}_su {node:U} au_{ref} DC 0",
    "R_{ref}_u au_{ref} bu_{ref} {R}",
    "L_{ref}_u bu_{ref} eu_{ref} {L}",
    "B_{ref}_fu fu_{ref} 0 V=sin(({pairs}*V(th_{ref})))",
    "B_{ref}_eu eu_{ref} n_{ref} V=({= V / (1.7320508 * rpm * 6.2831853 / 60)})*V(w_{ref})*V(fu_{ref})",
    "V_{ref}_sv {node:V} av_{ref} DC 0",
    "R_{ref}_v av_{ref} bv_{ref} {R}",
    "L_{ref}_v bv_{ref} ev_{ref} {L}",
    "B_{ref}_fv fv_{ref} 0 V=sin(({pairs}*V(th_{ref})-2.0943951))",
    "B_{ref}_ev ev_{ref} n_{ref} V=({= V / (1.7320508 * rpm * 6.2831853 / 60)})*V(w_{ref})*V(fv_{ref})",
    "V_{ref}_sw {node:W} aw_{ref} DC 0",
    "R_{ref}_w aw_{ref} bw_{ref} {R}",
    "L_{ref}_w bw_{ref} ew_{ref} {L}",
    "B_{ref}_fw fw_{ref} 0 V=sin(({pairs}*V(th_{ref})-4.1887902))",
    "B_{ref}_ew ew_{ref} n_{ref} V=({= V / (1.7320508 * rpm * 6.2831853 / 60)})*V(w_{ref})*V(fw_{ref})",
    "B_{ref}_t 0 w_{ref} I=({= V / (1.7320508 * rpm * 6.2831853 / 60)})*(V(fu_{ref})*I(V_{ref}_su)+V(fv_{ref})*I(V_{ref}_sv)+V(fw_{ref})*I(V_{ref}_sw))",
    "C_{ref}_j w_{ref} 0 {= tm * (1.5 * V / (1.7320508 * rpm * 6.2831853 / 60)) * (1.5 * V / (1.7320508 * rpm * 6.2831853 / 60)) / (2 * R)}",
    "R_{ref}_b w_{ref} 0 {= (rpm * 6.2831853 / 60) / ((1.5 * V / (1.7320508 * rpm * 6.2831853 / 60)) * Inoload)}",
    "B_{ref}_load w_{ref} 0 I={= (1.5 * V / (1.7320508 * rpm * 6.2831853 / 60)) * V / (2 * R)}*V({control})*tanh(V(w_{ref})/{= (rpm * 6.2831853 / 60) / 100})",
    "B_{ref}_th 0 th_{ref} I=V(w_{ref})",
    "C_{ref}_th th_{ref} 0 1",
    "R_{ref}_th th_{ref} 0 1T",
    "R_{ref}_n n_{ref} 0 1G",
    "B_{ref}_ha ha_{ref} 0 V=-sin({pairs}*V(th_{ref})-0.52359878-0*2.0943951)",
    "S_{ref}_ha {node:HA} {node:GND} ha_{ref} 0 SW_HALL",
    "B_{ref}_hb hb_{ref} 0 V=-sin({pairs}*V(th_{ref})-0.52359878-1*2.0943951)",
    "S_{ref}_hb {node:HB} {node:GND} hb_{ref} 0 SW_HALL",
    "B_{ref}_hc hc_{ref} 0 V=-sin({pairs}*V(th_{ref})-0.52359878-2*2.0943951)",
    "S_{ref}_hc {node:HC} {node:GND} hc_{ref} 0 SW_HALL"
  ]
}
