  "spice": [
    "B_{ref}_onout1 onout1_{ref} 0 V=0.5*(1+tanh(5*(V({node:VSS},{node:GND})-4)))*0.5*(1+tanh(10*(V({node:ENA},{node:GND})-1.9)))",
    "B_{ref}_xout1 xout1_{ref} 0 V=0.5*(1+tanh(10*(V({node:IN1},{node:GND})-1.9)))",
    "B_{ref}_hout1 {node:VS} {node:OUT1} I=V(onout1_{ref})*V(xout1_{ref})*V({node:VS},{node:OUT1})/1.3",
    "B_{ref}_lout1 {node:OUT1} {node:SENSA} I=V(onout1_{ref})*(1-V(xout1_{ref}))*V({node:OUT1},{node:SENSA})/1.3",
    "R_{ref}_fout1 {node:OUT1} {node:GND} 10Meg",
    "B_{ref}_onout2 onout2_{ref} 0 V=0.5*(1+tanh(5*(V({node:VSS},{node:GND})-4)))*0.5*(1+tanh(10*(V({node:ENA},{node:GND})-1.9)))",
