    "B_{ref}_hout2 {node:VS} {node:OUT2} I=V(onout2_{ref})*V(xout2_{ref})*V({node:VS},{node:OUT2})/1.3",
    "B_{ref}_lout2 {node:OUT2} {node:SENSA} I=V(onout2_{ref})*(1-V(xout2_{ref}))*V({node:OUT2},{node:SENSA})/1.3",
    "R_{ref}_fout2 {node:OUT2} {node:GND} 10Meg",
    "B_{ref}_onout3 onout3_{ref} 0 V=0.5*(1+tanh(5*(V({node:VSS},{node:GND})-4)))*0.5*(1+tanh(10*(V({node:ENB},{node:GND})-1.9)))",
