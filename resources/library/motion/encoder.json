          -2.4,
          0
        ]
      },
      {
        "line": [
          -5,
          2,
          -2,
          2
        ]
      },
      {
        "text": "A",
        "at": [
          -4,
          -2.6
        ],
        "size": 0.5
      },
      {
        "text": "C",
