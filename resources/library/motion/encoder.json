  "value_parameter": "position",
  "parameters": [
    {
      "name": "position",
      "label": "Position",
      "unit": "",
      "default": "10",
      "description": "Detent the knob starts at (0 to 20, one turn); drag or wheel while running",
      "min": "0",
      "max": "20"
    }
  ],
  "interactive": {
    "kind": "potentiometer",
    "parameter": "position"
  },
  "readout": {
    "kind": "node",
    "element": "pos_{ref}",
    "scale": 1,
    "unit": ""
  },
  "spice": [
    "B_{ref}_pos pos_{ref} 0 V=(20*V({control}))",
    "B_{ref}_a {node:A} {node:C} I=V({node:A},{node:C})*(u(((20*V({control}))-floor((20*V({control}))))-0.2)*u(0.6-((20*V({control}))-floor((20*V({control})))))*1+1e-9)",
    "B_{ref}_b {node:B} {node:C} I=V({node:B},{node:C})*(u(((20*V({control}))-floor((20*V({control}))))-0.4)*u(0.8-((20*V({control}))-floor((20*V({control})))))*1+1e-9)"
  ]
