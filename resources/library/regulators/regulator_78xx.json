        ],
        "dir": "down"
      }
    ]
  },
  "designator_offset": [
    -3,
    -4
  ],
  "value_offset": [
    3,
    3
  ],
  "value_parameter": "Vout",
  "parameters": [
    {
      "name": "Vout",
      "label": "Output voltage",
      "unit": "V",
      "default": "5",
      "description": "Regulated output voltage (5 for a 7805, 12 for a 7812)",
      "min": "0.5",
      "max": "40"
    },
    {
      "name": "Vdo",
      "label": "Dropout voltage",
      "unit": "V",
      "default": "2",
      "description": "Smallest IN-OUT difference that still regulates",
      "min": "0.05",
      "max": "5"
    },
    {
      "name": "Ilim",
      "label": "Current limit",
      "unit": "A",
      "default": "1",
      "description": "Largest output current",
      "min": "0.001",
      "max": "10"
    },
    {
      "name": "Iq",
      "label": "Quiescent current",
      "unit": "A",
      "default": "5m",
      "description": "Current from IN to GND for the regulator itself",
      "min": "0",
      "max": "0.1"
    }
  ],
  "spice": [
    "B_{ref}_c 0 c_{ref} I=1m*(min(max(min(100*({Vout}-V({node:OUT},{node:GND})),100*(V({node:IN},{node:OUT})-{Vdo})),0),{Ilim})-V(c_{ref}))",
    "C_{ref}_c c_{ref} 0 1n",
    "B_{ref}_p {node:IN} {node:OUT} I=max(V(c_{ref}),0)",
    "B_{ref}_q {node:IN} {node:GND} I={Iq}*tanh(max(V({node:IN},{node:GND}),0))",
    "R_{ref}_o {node:OUT} {node:GND} 1meg",
    "C_{ref}_o {node:OUT} {node:GND} 100n"
  ]
}
