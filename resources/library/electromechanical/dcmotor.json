    "L_{ref} a_{ref} b_{ref} 1m",
    "V_sense_{ref} b_{ref} e_{ref} DC 0",
    "B_{ref}_emf e_{ref} {node:-} V={= V * 60 / (6.2831853 * rpm)}*V(w_{ref})",
    "B_{ref}_t 0 w_{ref} I={= V * 60 / (6.2831853 * rpm)}*I(V_sense_{ref})",
    "C_{ref}_j w_{ref} 0 {= 0.05 * (V * 60 / (6.2831853 * rpm)) * (V * 60 / (6.2831853 * rpm)) * Istall / V}",
    "R_{ref}_b w_{ref} 0 {= (rpm * 6.2831853 / 60) / ((V * 60 / (6.2831853 * rpm)) * Inoload)}"
  ]
