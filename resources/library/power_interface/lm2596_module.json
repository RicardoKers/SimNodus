  "spice": [
    "B_{ref}_vs vs_{ref} 0 V=1.25+33.75*V({control})",
    "R_{ref}_ret {node:OUT-} {node:IN-} 0.01",
    "B_{ref}_c 0 c_{ref} I=1m*(1*min(max(min(500*(V(vs_{ref})-V({node:OUT+},{node:IN-})),500*(V({node:IN+},{node:OUT+})-1.5)),0),3.5)-V(c_{ref}))",
    "C_{ref}_c c_{ref} 0 100n",
    "B_{ref}_o {node:IN-} {node:OUT+} I=max(V(c_{ref}),0)",
    "B_{ref}_i {node:IN+} {node:IN-} I=max(V(c_{ref}),0)*max(V({node:OUT+},{node:IN-}),0)/(0.85*max(V({node:IN+},{node:IN-}),1))+5m*(1)",
    "R_{ref}_l {node:OUT+} {node:IN-} 100k"
  ]
