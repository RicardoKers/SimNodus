* SimNodus built-in SPICE models of basic parts (PRJ-07, ADR 0095).
* Copyright (c) 2026 Ricardo Kerschbaumer. SPDX-License-Identifier: MIT
*
* These are SimNodus's own approximations: parameters chosen from typical
* datasheet values (current gain, saturation, on-resistance, threshold,
* capacitances), rounded. They are not vendor models and are not measured
* fits; use them to learn how parts differ, not for design margins.
* The comment line above each statement is shown as its description.
* Models of the user go in the models folder (Tools > Open Models Folder).

* Generic small-signal NPN (SimNodus default)
.model Generic NPN(IS=14f BF=200 VAF=74 IKF=0.28 BR=6 RB=10 RC=1 CJE=22p CJC=7p TF=0.4n TR=46n)
* 2N2222A: general-purpose NPN, 40 V, 600 mA, hFE about 200 (approximation)
.model 2N2222A NPN(IS=14f BF=220 VAF=100 IKF=0.3 ISE=14f NE=1.5 BR=6 RB=10 RC=0.3 RE=0.1
+ CJE=22p MJE=0.38 CJC=7.3p MJC=0.33 TF=0.41n TR=46n)
* 2N3904: small-signal NPN, 40 V, 200 mA, hFE about 300 (approximation)
.model 2N3904 NPN(IS=6.7f BF=300 VAF=75 IKF=66m ISE=6.7f NE=1.26 BR=0.7 RB=10 RC=1
+ CJE=4.5p MJE=0.26 CJC=3.6p MJC=0.3 TF=0.3n TR=240n)
* BC547B: small-signal NPN, 45 V, 100 mA, hFE about 330 (approximation)
.model BC547B NPN(IS=7f BF=330 VAF=80 IKF=0.1 ISE=7f NE=1.5 BR=8 RB=10 RC=0.8
+ CJE=11p MJE=0.33 CJC=4.5p MJC=0.3 TF=0.4n TR=50n)
* BD139: medium-power NPN, 80 V, 1.5 A, hFE about 150 (approximation)
.model BD139 NPN(IS=100f BF=150 VAF=100 IKF=1 BR=10 RB=1 RC=0.1 CJE=100p CJC=30p TF=10n TR=200n)

* Generic small-signal PNP (SimNodus default)
.model Generic PNP(IS=650f BF=200 VAF=115 IKF=0.65 BR=4 RB=10 RC=1 CJE=20p CJC=9p TF=0.5n TR=50n)
* 2N2907A: general-purpose PNP, 60 V, 600 mA, hFE about 200 (approximation)
.model 2N2907A PNP(IS=20f BF=200 VAF=110 IKF=0.3 BR=6 RB=10 RC=0.4 CJE=30p CJC=12p TF=0.5n TR=50n)
* 2N3906: small-signal PNP, 40 V, 200 mA, hFE about 200 (approximation)
.model 2N3906 PNP(IS=1.4f BF=200 VAF=20 IKF=80m BR=4 RB=10 RC=2.5 CJE=4.5p CJC=4.5p TF=0.5n TR=30n)
* BC557B: small-signal PNP, 45 V, 100 mA, hFE about 290 (approximation)
.model BC557B PNP(IS=10f BF=290 VAF=50 IKF=0.1 BR=8 RB=10 RC=1 CJE=12p CJC=6p TF=0.5n TR=50n)
* BD140: medium-power PNP, 80 V, 1.5 A, hFE about 150 (approximation)
.model BD140 PNP(IS=100f BF=150 VAF=100 IKF=1 BR=10 RB=1 RC=0.1 CJE=110p CJC=40p TF=10n TR=200n)

* Generic small-signal silicon diode (SimNodus default, like a 1N4148)
.model Generic D(IS=2.52n N=1.752 RS=0.568 BV=100 IBV=100u CJO=4p M=0.333 TT=11.5n type=silicon)
* 1N4148: fast small-signal diode, 100 V, 200 mA (approximation)
.model 1N4148 D(IS=2.52n N=1.752 RS=0.568 BV=100 IBV=100u CJO=4p M=0.333 TT=11.5n type=silicon)
* 1N4007: rectifier diode, 1000 V, 1 A, slow recovery (approximation)
.model 1N4007 D(IS=7n N=1.8 RS=0.04 BV=1000 IBV=5u CJO=15p M=0.33 TT=3u type=silicon)
* 1N5408: rectifier diode, 1000 V, 3 A (approximation)
.model 1N5408 D(IS=10n N=1.8 RS=0.01 BV=1000 IBV=10u CJO=50p M=0.33 TT=5u type=silicon)
* 1N5819: Schottky diode, 40 V, 1 A, about 0.4 V forward (approximation)
.model 1N5819 D(IS=1.2u N=1.05 RS=0.04 BV=40 IBV=1m CJO=110p M=0.35 EG=0.69 XTI=2 type=schottky)

* BAT54: small-signal Schottky diode, 30 V, 200 mA, about 0.32 V at 1 mA (approximation)
.model BAT54 D(IS=1e-7 N=1.05 RS=2 BV=30 IBV=2u CJO=10p M=0.33 EG=0.69 XTI=2 type=schottky)
* 1N5822: Schottky rectifier, 40 V, 3 A, about 0.5 V at 3 A (approximation)
.model 1N5822 D(IS=4u N=1.1 RS=0.01 BV=40 IBV=1m CJO=400p M=0.35 EG=0.69 XTI=2 type=schottky)
* 1N34A: germanium point-contact diode, 60 V, 50 mA, about 0.3 V at 1 mA (approximation)
.model 1N34A D(IS=1e-6 N=1.5 RS=5 BV=60 IBV=15u CJO=1p M=0.33 EG=0.67 XTI=3 type=germanium)
* 1N60: germanium signal diode for AM detectors, 40 V, about 0.27 V at 1 mA (approximation)
.model 1N60 D(IS=3e-7 N=1.3 RS=8 BV=40 IBV=10u CJO=1p M=0.33 EG=0.67 XTI=3 type=germanium)

* Generic N-channel MOSFET, threshold 2.1 V (SimNodus default)
.model Generic NMOS(LEVEL=1 VTO=2.1 KP=0.1 LAMBDA=0.02 CGSO=20n CGDO=5n)
* 2N7000: small-signal N-MOSFET, 60 V, 200 mA, about 1.8 ohm at 10 V (approximation)
.model 2N7000 NMOS(LEVEL=1 VTO=2.1 KP=0.07 LAMBDA=0.01 CGSO=150n CGDO=50n)
* BS170: small-signal N-MOSFET, 60 V, 500 mA, about 1.2 ohm at 10 V (approximation)
.model BS170 NMOS(LEVEL=1 VTO=2.0 KP=0.1 LAMBDA=0.01 CGSO=200n CGDO=50n)
* IRF540N: power N-MOSFET, 100 V, 33 A, about 44 mohm at 10 V (approximation)
.model IRF540N NMOS(LEVEL=1 VTO=3.0 KP=3.2 LAMBDA=0.005 CGSO=17u CGDO=2.5u)
* IRLZ44N: logic-level power N-MOSFET, 55 V, 47 A, about 22 mohm at 5 V (approximation)
.model IRLZ44N NMOS(LEVEL=1 VTO=1.5 KP=13 LAMBDA=0.005 CGSO=15u CGDO=2u)

* Generic P-channel MOSFET, threshold -2.0 V (SimNodus default)
.model Generic PMOS(LEVEL=1 VTO=-2.0 KP=0.05 LAMBDA=0.02 CGSO=20n CGDO=5n)
* BS250: small-signal P-MOSFET, 45 V, 230 mA, about 14 ohm at 10 V (approximation)
.model BS250 PMOS(LEVEL=1 VTO=-2.0 KP=0.009 LAMBDA=0.01 CGSO=200n CGDO=50n)
* IRF9540N: power P-MOSFET, 100 V, 23 A, about 0.12 ohm at 10 V (approximation)
.model IRF9540N PMOS(LEVEL=1 VTO=-3.0 KP=1.2 LAMBDA=0.005 CGSO=12u CGDO=3u)
