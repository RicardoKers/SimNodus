{
  "type": "simple_npn",
  "name": "NPN transistor (simple)",
  "category": "Simplified models",
  "prefix": "Q",
  "description": "Teaching model: the base-emitter junction conducts above Vbe; the collector carries beta times the base current until the transistor saturates near Vce(sat); no capacitances",
  "symbol": {
    "graphics": [
      {
        "line": [
          -3,
          0,
          -0.6,
          0
        ]
      },
      {
        "line": [
          -0.6,
          -1.4,
          -0.6,
          1.4
        ]
      },
      {
        "line": [
          -0.6,
          -0.6,
          2,
          -2
        ]
      },
      {
        "line": [
          2,
          -2,
          2,
          -3
        ]
      },
      {
        "line": [
          -0.6,
          0.6,
          2,
          2
        ]
      },
      {
        "line": [
          2,
          2,
          2,
          3
        ]
      },
      {
        "polygon": [
          1.6,
          1.8,
          0.9,
          1.9,
          1.3,
          1.2
        ],
        "fill": true
      }
    ],
    "pins": [
      {
        "name": "B",
        "at": [
          -3,
          0
        ],
        "dir": "left"
      },
      {
        "name": "C",
        "at": [
          2,
          -3
        ],
        "dir": "up"
      },
      {
        "name": "E",
        "at": [
          2,
          3
        ],
        "dir": "down"
      }
    ]
  },
  "designator_offset": [
    3,
    -1
  ],
  "value_offset": [
    3,
    1
  ],
  "value_parameter": "beta",
  "parameters": [
    {
      "name": "beta",
      "label": "Current gain",
      "symbol": "β",
      "unit": "",
      "default": "100",
      "description": "Collector current divided by base current (hFE)",
      "min": "1",
      "max": "10000"
    },
    {
      "name": "Vbe",
      "label": "Base-emitter voltage",
      "unit": "V",
      "default": "0.7",
      "description": "Base-emitter voltage while conducting (magnitude)",
      "min": "0",
      "max": "2"
    },
    {
      "name": "Vcesat",
      "label": "Saturation voltage",
      "unit": "V",
      "default": "0.2",
      "description": "Collector-emitter voltage of a saturated transistor (magnitude)",
      "min": "0.01",
      "max": "2"
    }
  ],
  "spice": [
    "B_{ref}_b {node:B} {node:E} I=max(V({node:B},{node:E})-{Vbe},0)/1+V({node:B},{node:E})*1e-9",
    "B_{ref}_c {node:C} {node:E} I={beta}*max(V({node:B},{node:E})-{Vbe},0)/1*min(max((V({node:C},{node:E})-{Vcesat})/0.02+1,0),1)+V({node:C},{node:E})*1e-9"
  ]
}
