{
  "type": "simple_pnp",
  "name": "PNP transistor (simple)",
  "category": "Simplified models",
  "prefix": "Q",
  "description": "Teaching model: fixed Vbe, collector current = beta x base current",
  "symbol": {
    "graphics": [
      {
        "line": [
