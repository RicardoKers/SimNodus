          -3
        ]
      },
      {
        "line": [
          -0.6,
          0.6,
          2,
          2
        ]
      },
      {
        "line": [
          2,
          2,
          2,
          3
        ]
      },
      {
        "polygon": [
          -0.2,
          -0.8,
          0.7,
          -0.75,
          0.35,
          -1.45
        ],
        "fill": true
      }
    ],
    "pins": [
      {
        "name": "B",
        "at": [
          -3,
          0
        ],
        "dir": "left"
      },
      {
        "name": "E",
        "at": [
