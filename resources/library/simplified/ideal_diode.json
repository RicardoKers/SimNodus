      "min": "0",
      "max": "5"
    }
  ],
  "spice": [
    "B_{ref} {node:A} {node:K} I=max(V({node:A},{node:K})-{Vf},0)/0.1+V({node:A},{node:K})*1e-9"
  ]
}
