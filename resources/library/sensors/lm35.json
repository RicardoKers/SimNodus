      "name": "temperature",
      "label": "Temperature",
      "unit": "°C",
      "default": "25",
      "description": "Temperature of the sensor; drag the part or use the wheel while running (-55 to 150 °C)",
      "min": "-55",
      "max": "150"
    }
  ],
  "interactive": {
    "kind": "potentiometer",
    "parameter": "temperature"
  },
  "readout": {
    "kind": "node",
    "element": "q_{ref}",
    "scale": 1,
    "unit": "°C"
  },
  "spice": [
    "B_{ref}_q q_{ref} 0 V=-55+(150-(-55))*V({control})",
    "B_{ref}_o o_{ref} {node:GND} V=0.5*(1+tanh(5*(V({node:VS},{node:GND})-3.6)))*min(max(0.01*V(q_{ref}),0),max(V({node:VS},{node:GND})-1.5,0))",
    "R_{ref}_o o_{ref} {node:VOUT} 1",
    "R_{ref}_s {node:VS} {node:GND} 90k"
  ]
