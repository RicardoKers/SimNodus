    "R_{ref}_st st_{ref} 0 1G",
    "B_{ref}_o o_{ref} {node:GND} V=3.3*0.5*(1+tanh(5*(V({node:VCC},{node:GND})-4.5)))*0.5*(1+tanh(200*(V(st_{ref})-0.5)))",
