  "designator_offset": [
    6,
    -7
  ],
  "value_offset": [
    6,
    7
  ],
  "value_parameter": "sensitivity",
  "parameters": [
    {
      "name": "sensitivity",
      "label": "Sensitivity",
      "unit": "V/A",
      "default": "185m",
      "description": "185 mV/A for the ACS712-05B (±5 A), 100 mV/A for -20A, 66 mV/A for -30A",
      "min": "1m",
      "max": "10"
    }
  ],
  "readout": {
    "kind": "current",
    "element": "V_{ref}_s"
  },
  "spice": [
    "R_{ref}_p {node:IP+} m_{ref} 1.2m",
    "V_{ref}_s m_{ref} {node:IP-} DC 0",
    "B_{ref}_o o_{ref} {node:GND} V=0.5*(1+tanh(5*(V({node:VCC},{node:GND})-4)))*min(max(V({node:VCC},{node:GND})*(0.5+{sensitivity}*I(V_{ref}_s)/5),0),V({node:VCC},{node:GND}))",
    "R_{ref}_o o_{ref} {node:VOUT} 1",
    "R_{ref}_q {node:VCC} {node:GND} 500"
  ]
}
