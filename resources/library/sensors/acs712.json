{
  "type": "acs712",
  "name": "Current sensor ACS712",
  "category": "Sensors",
  "prefix": "U",
  "description": "Hall-effect current sensor: VOUT = VCC/2 + sensitivity × current from IP+ to IP- (ratiometric to a 5 V supply); the current path is 1.2 mΩ and isolated from the outputs",
