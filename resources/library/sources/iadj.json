{
  "type": "iadj",
  "name": "Adjustable current source",
  "category": "Sources",
  "prefix": "I",
  "description": "Current between a lower and an upper limit, turned while running",
  "symbol": {
    "graphics": [
      {
        "circle": [
          0,
          0,
          1.5
        ]
      },
      {
        "line": [
          0,
          -3,
          0,
          -1.5
        ]
      },
      {
        "line": [
          0,
          1.5,
          0,
          3
        ]
      },
      {
        "line": [
          0,
          0.9,
          0,
          -0.6
        ]
      },
      {
        "polygon": [
          0,
          -1,
          -0.4,
          -0.3,
          0.4,
          -0.3
        ],
        "fill": true
      },
      {
        "line": [
          -1.8,
          1.8,
          1.6,
          -1.6
        ]
      },
      {
        "polygon": [
          1.9,
          -1.9,
          1.0,
          -1.6,
          1.6,
          -1.0
        ],
        "fill": true
      }
    ],
    "pins": [
      {
        "name": "+",
        "at": [
          0,
          -3
        ],
        "dir": "up"
      },
      {
        "name": "-",
        "at": [
          0,
          3
        ],
        "dir": "down"
      }
    ]
  },
  "parameters": [
    {
      "name": "Imin",
      "label": "Lower limit",
      "unit": "A",
      "default": "0",
      "description": "Current out of + at 0 %"
    },
    {
      "name": "Imax",
      "label": "Upper limit",
      "unit": "A",
      "default": "10m",
      "description": "Current out of + at 100 %"
    },
    {
      "name": "position",
      "label": "Position",
      "unit": "%",
      "default": "50",
      "description": "Where the value starts, from the lower (0 %) to the upper limit (100 %); drag the source or use the wheel while running",
      "min": "0",
      "max": "100"
    }
  ],
  "interactive": {
    "kind": "potentiometer",
    "parameter": "position"
  },
  "readout": {
    "kind": "current",
    "element": "V_{ref}_m"
  },
  "spice": [
    "B_{ref} {node:-} m_{ref} I={Imin}+({Imax}-{Imin})*V({control})",
    "V_{ref}_m m_{ref} {node:+} DC 0"
  ]
}
