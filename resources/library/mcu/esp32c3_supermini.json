  "value_parameter": "firmware",
  "parameters": [
    {
      "name": "firmware",
      "label": "Firmware",
      "kind": "file",
      "filter": "*.bin",
      "default": "",
      "description": "Flash image for the ESP32-C3, written from address 0 (a merged .bin of ESP-IDF or Arduino, or MicroPython's firmware .bin), or an application .bin with its build's flash_args beside it; stored relative to the project"
    },
    {
      "name": "usb_link",
      "label": "USB Serial/JTAG to the computer",
      "kind": "text",
      "host_link": true,
      "default": "",
      "description": "The board's USB connector (the chip's own USB Serial/JTAG) linked to the computer: a serial port (one end of a virtual port pair such as com0com), tcp:4001 for programs that speak RFC 2217 (esptool, mpremote), or empty for none. DTR and RTS reset the chip and select download mode as the USB Serial/JTAG does"
    },
    {
      "name": "chip_temperature",
      "label": "Chip temperature",
      "unit": "°C",
      "default": "25",
      "min": "-40",
      "max": "125",
      "live": true,
      "description": "Temperature of the chip that its temperature sensor measures; change it while running to test the firmware (-40 to 125 °C)"
    }
  ],
  "mcu": {
    "chip": "esp32c3",
    "firmware_parameter": "firmware",
    "led": {
      "pin": "GPIO8",
      "active_low": true,
      "at": [
        0,
        6
      ],
      "radius": 0.6
    },
    "reset_button": [
      -2,
      0,
      4,
      2
    ],
    "pin_model": {
      "supply": 3.3,
      "output_resistance": 33,
      "pull_resistance": 45000,
      "input_high": 2.475,
      "input_low": 0.825
    },
    "uarts": [
      {
        "name": "usb",
        "label": "USB Serial/JTAG (the USB connector)",
        "tx_pin": "",
        "rx_pin": "",
        "link_parameter": "usb_link",
        "reset_circuit": "usb_jtag"
      },
      {
        "name": "uart0",
        "label": "UART0 (GPIO21 TX, GPIO20 RX)",
        "tx_pin": "GPIO21",
        "rx_pin": "GPIO20"
      }
    ]
  },
  "spice": [
    "V_{ref}_reg reg_{ref} {node:G1} DC 3.3",
    "R_{ref}_reg reg_{ref} {node:3V3} 0.1",
    "R_{ref}_5v {node:5V} {node:G1} 10Meg",
