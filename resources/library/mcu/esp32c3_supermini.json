    "R_{ref}_gpio3 {node:GPIO3} {node:G1} 100Meg",
    "R_{ref}_gpio2 {node:GPIO2} {node:G1} 100Meg",
    "R_{ref}_gpio1 {node:GPIO1} {node:G1} 100Meg",
    "R_{ref}_gpio0 {node:GPIO0} {node:G1} 100Meg",
    "B_{ref}_gpio5 {node:G1} {node:GPIO5} I=V({ext:gpio5_i})-V({ext:gpio5_g})*(V({node:GPIO5})-V({node:G1}))",
    "B_{ref}_gpio6 {node:G1} {node:GPIO6} I=V({ext:gpio6_i})-V({ext:gpio6_g})*(V({node:GPIO6})-V({node:G1}))",
    "B_{ref}_gpio7 {node:G1} {node:GPIO7} I=V({ext:gpio7_i})-V({ext:gpio7_g})*(V({node:GPIO7})-V({node:G1}))",
    "B_{ref}_gpio8 {node:G1} {node:GPIO8} I=V({ext:gpio8_i})-V({ext:gpio8_g})*(V({node:GPIO8})-V({node:G1}))",
    "B_{ref}_gpio9 {node:G1} {node:GPIO9} I=V({ext:gpio9_i})-V({ext:gpio9_g})*(V({node:GPIO9})-V({node:G1}))",
    "B_{ref}_gpio10 {node:G1} {node:GPIO10} I=V({ext:gpio10_i})-V({ext:gpio10_g})*(V({node:GPIO10})-V({node:G1}))",
    "B_{ref}_gpio20 {node:G1} {node:GPIO20} I=V({ext:gpio20_i})-V({ext:gpio20_g})*(V({node:GPIO20})-V({node:G1}))",
    "B_{ref}_gpio21 {node:G1} {node:GPIO21} I=V({ext:gpio21_i})-V({ext:gpio21_g})*(V({node:GPIO21})-V({node:G1}))",
