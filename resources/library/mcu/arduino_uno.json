  "parameters": [
    {
      "name": "firmware",
      "label": "Firmware",
      "kind": "file",
      "filter": "*.hex *.elf *.bin",
      "default": "",
      "description": "The sketch: an Intel HEX file (the Arduino IDE's Sketch > Export Compiled Binary, with or without the bootloader) or an avr-gcc ELF file; stored relative to the project. Empty: the board has only its bootloader and waits for an upload through the USB connector. After an upload, SimNodus keeps the flash as <designator>-flash.bin"
    },
    {
      "name": "eeprom",
      "label": "EEPROM",
      "kind": "file",
      "filter": "*.bin",
      "default": "",
      "description": "EEPROM contents (1 KB). SimNodus keeps what the sketch writes as <designator>-eeprom.bin beside the project; empty: erased"
    },
    {
      "name": "usb_link",
      "label": "USB to the computer",
      "kind": "text",
      "host_link": true,
      "default": "",
      "description": "The board's USB connector linked to the computer: a serial port (one end of a virtual port pair such as com0com; the Arduino IDE uploads and opens its Serial Monitor on the other end), tcp:4000 for programs that speak RFC 2217, or empty for none. DTR resets the board, as the IDE does before an upload"
    }
  ],
  "mcu": {
    "chip": "atmega328p",
    "firmware_parameter": "firmware",
    "ground_pin": "GND1",
    "pin_model": {
      "supply": 5.0,
      "output_resistance": 35,
      "pull_resistance": 35000,
      "input_high": 3.0,
      "input_low": 1.5
