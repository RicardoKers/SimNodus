        "name": "usart",
        "label": "USB (USART: D1 TX, D0 RX)",
        "tx_pin": "D1",
        "rx_pin": "D0",
        "link_parameter": "usb_link",
        "reset_circuit": "dtr_reset"
      }
    ],
    "parameters": {
      "fuse_low": "FF",
      "fuse_high": "DE",
      "fuse_extended": "FD",
      "lock": "0F",
      "crystal_hz": "16000000",
      "bootloader": "optiboot_atmega328.hex"
    }
  },
