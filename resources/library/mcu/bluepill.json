    }
  ],
  "mcu": {
    "platform": "stm32f103c8.repl",
    "firmware_parameter": "firmware",
    "before_firmware": [
      "sysbus WriteDoubleWord 0x40021000 0x83"
    ],
    "after_firmware": [
      "sysbus.cpu VectorTableOffset 0x08000000"
    ],
    "led": {
      "pin": "PC13",
      "active_low": true,
      "at": [
        0,
        -16
      ],
      "radius": 0.6
    },
