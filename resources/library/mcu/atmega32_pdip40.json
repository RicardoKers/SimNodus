      "label": "Low fuse",
      "kind": "text",
      "default": "E1",
      "description": "Low fuse byte in hex (programmed bits are 0). E1, the factory value: internal RC oscillator at 1 MHz, 65 ms start-up. EF with a 16 MHz Crystal between XTAL1 and XTAL2 (and the high fuse 89)"
    },
    {
      "name": "fuse_high",
      "label": "High fuse",
      "kind": "text",
      "default": "99",
      "description": "High fuse byte in hex (programmed bits are 0). 99, the factory value: JTAGEN programmed, so PC2-PC5 are the JTAG pins until the firmware sets JTD; D9 frees them. Bit 7 OCDEN, 6 JTAGEN, 5 SPIEN, 4 CKOPT, 3 EESAVE, 2-1 BOOTSZ, 0 BOOTRST"
    },
    {
      "name": "lock",
      "label": "Lock bits",
      "kind": "text",
      "default": "FF",
      "description": "Lock byte in hex; FF: no lock. The boot lock bits restrict SPM and LPM"
    },
    {
      "name": "eeprom",
      "label": "EEPROM",
      "kind": "file",
      "filter": "*.bin",
      "default": "",
      "description": "EEPROM contents (1 KB). SimNodus keeps what the firmware writes as <designator>-eeprom.bin beside the project; empty: erased, or the firmware's own EEPROM data"
    },
    {
      "name": "usart_link",
      "label": "USART to the computer",
      "kind": "text",
      "host_link": true,
      "default": "",
      "description": "The USART (PD1 TX, PD0 RX) linked to the computer as through a USB-serial adapter: a serial port (one end of a virtual port pair such as com0com), tcp:4000 for programs that speak RFC 2217, or empty for none"
    }
