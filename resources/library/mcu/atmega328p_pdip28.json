  "parameters": [
    {
      "name": "firmware",
      "label": "Firmware",
      "kind": "file",
      "filter": "*.hex *.elf",
      "default": "",
      "description": "Firmware for the chip: an Intel HEX file (Microchip Studio, MPLAB X, avr-objcopy, the Arduino IDE's exported binary) or an avr-gcc ELF file, whose fuses and EEPROM data apply too; stored relative to the project"
    },
    {
      "name": "fuse_low",
      "label": "Low fuse",
      "kind": "text",
      "default": "62",
      "description": "Low fuse byte in hex (programmed bits are 0). 62, the factory value: internal 8 MHz RC oscillator divided by 8 (CKDIV8), 1 MHz, 65 ms start-up. E2: 8 MHz. FF with a 16 MHz Crystal between XTAL1 and XTAL2, as on the Arduino UNO"
    },
    {
      "name": "fuse_high",
      "label": "High fuse",
      "kind": "text",
      "default": "D9",
      "description": "High fuse byte in hex (programmed bits are 0). D9, the factory value; DE on the Arduino UNO. Bit 7 RSTDISBL (PC6 as I/O), 6 DWEN, 5 SPIEN, 4 WDTON, 3 EESAVE, 2-1 BOOTSZ, 0 BOOTRST"
    },
    {
      "name": "fuse_extended",
      "label": "Extended fuse",
      "kind": "text",
      "default": "FF",
      "description": "Extended fuse byte in hex: BODLEVEL2:0 in bits 2-0. FF: brown-out detection off (the factory value), FE 1.8 V, FD 2.7 V (the Arduino UNO), FC 4.3 V"
    },
    {
      "name": "lock",
      "label": "Lock bits",
      "kind": "text",
      "default": "FF",
      "description": "Lock byte in hex; FF: no lock. The boot lock bits restrict SPM and LPM"
    },
    {
      "name": "eeprom",
      "label": "EEPROM",
      "kind": "file",
      "filter": "*.bin",
      "default": "",
      "description": "EEPROM contents (1 KB). SimNodus keeps what the firmware writes as <designator>-eeprom.bin beside the project; empty: erased, or the firmware's own EEPROM data"
    },
    {
      "name": "usart_link",
      "label": "USART to the computer",
      "kind": "text",
      "host_link": true,
      "default": "",
      "description": "The USART (PD1 TX, PD0 RX) linked to the computer as through a USB-serial adapter: a serial port (one end of a virtual port pair such as com0com), tcp:4000 for programs that speak RFC 2217, or empty for none"
    }
  ],
  "mcu": {
    "chip": "atmega328p",
    "firmware_parameter": "firmware",
    "ground_pin": "GND",
    "pin_model": {
      "supply": 5.0,
      "output_resistance": 35,
      "pull_resistance": 35000,
      "input_high": 3.0,
      "input_low": 1.5
    },
    "uarts": [
      {
        "name": "usart",
        "label": "USART (PD1 TX, PD0 RX)",
        "tx_pin": "PD1",
        "rx_pin": "PD0",
        "link_parameter": "usart_link",
        "reset_circuit": ""
      }
    ]
  },
  "spice": [
    "R_{ref}_gnd2 {node:GND} {node:GND2} 1m",
    "R_{ref}_vcc {node:VCC} {node:GND} 2.5k",
    "R_{ref}_avcc {node:AVCC} {node:GND} 100k",
    "R_{ref}_aref {node:AREF} {node:GND} 32k",
    "R_{ref}_pc6 {node:PC6} {node:GND} 100Meg",
    "B_{ref}_pc6 {node:GND} {node:PC6} I=V({ext:pc6_i})-V({ext:pc6_g})*(V({node:PC6})-V({node:GND}))",
    "R_{ref}_pd0 {node:PD0} {node:GND} 100Meg",
