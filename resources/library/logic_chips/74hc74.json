    "B_{ref}_lv0 lv0_{ref} 0 V=0.5*(1+tanh(8*(V({node:1PREN},{node:GND})-0.5*V({node:VCC},{node:GND}))))",
    "B_{ref}_lv1 lv1_{ref} 0 V=0.5*(1+tanh(8*(V({node:1CLRN},{node:GND})-0.5*V({node:VCC},{node:GND}))))",
