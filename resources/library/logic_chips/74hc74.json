    "B_{ref}_lqn2 {node:2QN} {node:GND} I=(1-min(max(V(yqn2_{ref}),0),1))*V({node:2QN},{node:GND})/50",
    "R_{ref}_i1clrn {node:1CLRN} {node:GND} 1G",
    "R_{ref}_i1d {node:1D} {node:GND} 1G",
