    "B_{ref}_m1 0 m1_{ref} I=1m*((1-(1-V(lv0_{ref})))*(1-(1-V(lv1_{ref})))*(1-0.5*(1+tanh(8*(V({node:1CLK},{node:GND})-0.4*V({node:VCC},{node:GND})))))*(0.5*(1+tanh(8*(V({node:1D},{node:GND})-0.5*V({node:VCC},{node:GND}))))-V(m1_{ref}))+(1-V(lv0_{ref}))*(1-V(m1_{ref}))-(1-V(lv1_{ref}))*V(m1_{ref}))",
    "C_{ref}_m1 m1_{ref} 0 1p",
    "B_{ref}_s1 0 s1_{ref} I=1m*((1-(1-V(lv0_{ref})))*(1-(1-V(lv1_{ref})))*0.5*(1+tanh(8*(V({node:1CLK},{node:GND})-0.6*V({node:VCC},{node:GND}))))*(V(m1_{ref})-V(s1_{ref}))+(1-V(lv0_{ref}))*(1-V(s1_{ref}))-(1-V(lv1_{ref}))*V(s1_{ref}))",
    "C_{ref}_s1 s1_{ref} 0 1p",
    "B_{ref}_xq1 xq1_{ref} 0 V=V(lv2_{ref})",
    "R_{ref}_dq1 xq1_{ref} yq1_{ref} 1k",
    "C_{ref}_dq1 yq1_{ref} 0 10p",
    "B_{ref}_uq1 {node:VCC} {node:1Q} I=min(max(V(yq1_{ref}),0),1)*V({node:VCC},{node:1Q})/50",
    "B_{ref}_lq1 {node:1Q} {node:GND} I=(1-min(max(V(yq1_{ref}),0),1))*V({node:1Q},{node:GND})/50",
    "B_{ref}_xqn1 xqn1_{ref} 0 V=(1-V(lv2_{ref}))",
    "R_{ref}_dqn1 xqn1_{ref} yqn1_{ref} 1k",
    "C_{ref}_dqn1 yqn1_{ref} 0 10p",
    "B_{ref}_uqn1 {node:VCC} {node:1QN} I=min(max(V(yqn1_{ref}),0),1)*V({node:VCC},{node:1QN})/50",
    "B_{ref}_lqn1 {node:1QN} {node:GND} I=(1-min(max(V(yqn1_{ref}),0),1))*V({node:1QN},{node:GND})/50",
    "B_{ref}_m2 0 m2_{ref} I=1m*((1-(1-V(lv3_{ref})))*(1-(1-V(lv4_{ref})))*(1-0.5*(1+tanh(8*(V({node:2CLK},{node:GND})-0.4*V({node:VCC},{node:GND})))))*(0.5*(1+tanh(8*(V({node:2D},{node:GND})-0.5*V({node:VCC},{node:GND}))))-V(m2_{ref}))+(1-V(lv3_{ref}))*(1-V(m2_{ref}))-(1-V(lv4_{ref}))*V(m2_{ref}))",
    "C_{ref}_m2 m2_{ref} 0 1p",
    "B_{ref}_s2 0 s2_{ref} I=1m*((1-(1-V(lv3_{ref})))*(1-(1-V(lv4_{ref})))*0.5*(1+tanh(8*(V({node:2CLK},{node:GND})-0.6*V({node:VCC},{node:GND}))))*(V(m2_{ref})-V(s2_{ref}))+(1-V(lv3_{ref}))*(1-V(s2_{ref}))-(1-V(lv4_{ref}))*V(s2_{ref}))",
    "C_{ref}_s2 s2_{ref} 0 1p",
    "B_{ref}_xq2 xq2_{ref} 0 V=V(lv5_{ref})",
    "R_{ref}_dq2 xq2_{ref} yq2_{ref} 1k",
    "C_{ref}_dq2 yq2_{ref} 0 10p",
    "B_{ref}_uq2 {node:VCC} {node:2Q} I=min(max(V(yq2_{ref}),0),1)*V({node:VCC},{node:2Q})/50",
    "B_{ref}_lq2 {node:2Q} {node:GND} I=(1-min(max(V(yq2_{ref}),0),1))*V({node:2Q},{node:GND})/50",
    "B_{ref}_xqn2 xqn2_{ref} 0 V=(1-V(lv5_{ref}))",
