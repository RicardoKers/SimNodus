  "parameters": [
    {
      "name": "Vdrop",
      "label": "Output high drop",
      "unit": "V",
      "default": "1.7",
      "description": "OUT high is this far below VCC (1.7 V for the bipolar NE555; 0 for a CMOS 555)",
      "min": "0",
      "max": "3"
    }
  ],
  "spice": [
    "R_{ref}_1 {node:VCC} {node:CTRL} 5k",
    "R_{ref}_2 {node:CTRL} lo_{ref} 5k",
    "R_{ref}_3 lo_{ref} {node:GND} 5k",
    "B_{ref}_m 0 m_{ref} I=1m*(0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*0.5*(1+tanh((V(lo_{ref},{node:GND})-V({node:TRIG},{node:GND}))/0.005))*(1-0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*(1-0.5*(1+tanh((V({node:RESET},{node:GND})-0.7)/0.005))))*(1-V(m_{ref}))-((0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*0.5*(1+tanh((V({node:THR},{node:GND})-V({node:CTRL},{node:GND}))/0.005)))*(1-0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*0.5*(1+tanh((V(lo_{ref},{node:GND})-V({node:TRIG},{node:GND}))/0.005)))+0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*(1-0.5*(1+tanh((V({node:RESET},{node:GND})-0.7)/0.005))))*V(m_{ref})+(1-0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*0.5*(1+tanh((V(lo_{ref},{node:GND})-V({node:TRIG},{node:GND}))/0.005)))*(1-0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*0.5*(1+tanh((V({node:THR},{node:GND})-V({node:CTRL},{node:GND}))/0.005)))*(1-0.5*(1+tanh((V({node:VCC},{node:GND})-3)/0.005))*(1-0.5*(1+tanh((V({node:RESET},{node:GND})-0.7)/0.005))))*(0.5*(1+tanh((V(m_{ref})-0.5)/0.005))-V(m_{ref})))",
    "C_{ref}_m m_{ref} 0 1p",
    "B_{ref}_s 0 s_{ref} I=1m*(0.5*(1+tanh((V(m_{ref})-0.9)/0.005))*(1-V(s_{ref}))-0.5*(1+tanh((0.1-V(m_{ref}))/0.005))*V(s_{ref}))",
    "C_{ref}_s s_{ref} 0 1p",
    "B_{ref}_o o_{ref} {node:GND} V=0.5*(1+tanh((V(s_{ref})-0.5)/0.005))*max(V({node:VCC},{node:GND})-{Vdrop},0)",
    "R_{ref}_o o_{ref} {node:OUT} 10",
    "B_{ref}_d {node:DIS} {node:GND} I=V({node:DIS},{node:GND})*(1-0.5*(1+tanh((V(s_{ref})-0.5)/0.005)))/10",
    "R_{ref}_r {node:VCC} {node:RESET} 100k",
    "R_{ref}_q {node:VCC} {node:GND} 2k",
    "R_{ref}_t {node:TRIG} {node:GND} 1G",
    "R_{ref}_h {node:THR} {node:GND} 1G",
    "R_{ref}_x {node:DIS} {node:GND} 1G"
  ]
