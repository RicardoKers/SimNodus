  "notes": [
    {
      "id": 44,
      "at": [
        -10,
        -34
      ],
      "text": "4x4 matrix keypad scanned by a Blue Pill (STM32CubeIDE-style HAL project firmware/hal_keypad): rows R1-R4\non PA0-PA3 (open-drain, one low at a time), columns C1-C4 on PA4-PA7 (inputs with pull-ups). Run (F5),\nopen Analyzer > UART and click a key of KP1: \"Key: 5\" appears and the LED lights while the key is held.\nAnalyzer > Logic shows the scan on the row and column pins."
    }
  ]
