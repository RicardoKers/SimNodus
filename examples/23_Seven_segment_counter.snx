  "notes": [
    {
      "id": 46,
      "at": [
        -2,
        -18
      ],
      "text": "A 2 Hz clock drives a decade counter (0-9); a 4511 decoder turns the BCD code into segments of a\ncommon-cathode display, one 330 ohm resistor per segment. Run (F5) at real time and watch it count.\nLabels Q0..Q3 and Sa..Sg join the parts. For a common-anode display use the 7447 decoder."
    }
  ]
